FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 4.754439537158928e-05;

boundaryField
{
    frontAndBack
    {
        type            empty;
    }
    symmetry
    {
        type            symmetry;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    outlet
    {
        type            zeroGradient;
    }
    cylinder
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
}

