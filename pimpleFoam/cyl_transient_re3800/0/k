FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.0012183749999999998;

boundaryField
{
    frontAndBack
    {
        type            empty;
    }
    symmetry
    {
        type            symmetry;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 0.0012183749999999998;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.0012183749999999998;
        value           uniform 0.0012183749999999998;
    }
    cylinder
    {
        type            kqRWallFunction;
        value           uniform 0.0012183749999999998;
    }
}

