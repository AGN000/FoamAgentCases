FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState Boussinesq;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie      { molWeight 28.9; }
    equationOfState { rho0 1.225; T0 300; beta 0.003; }
    thermodynamics  { Cp 1004; Hf 0; }
    transport       { mu 1.8e-05; Pr 0.71; }
}

